# Run python scripts/init_env.py to generate unique secrets (private .env).
# API and PostgreSQL/Redis defaults for lab07 are isolated from earlier labs.
POSTGRES_PASSWORD=replace-with-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg2://sirius:replace-with-random-database-password@127.0.0.1:15437/sirius
REDIS_URL=redis://127.0.0.1:16384/0
RABBITMQ_USER=sirius
RABBITMQ_PASSWORD=replace-with-random-rabbitmq-password
RABBITMQ_URL=amqp://sirius:replace-with-random-rabbitmq-password@127.0.0.1:5677/
DEMO_NO_COURIER=false
OUTBOX_POLL_SECONDS=2
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]
DELIVERY_GRPC_TARGET=127.0.0.1:50051
DELIVERY_GRPC_BIND=127.0.0.1:50051
