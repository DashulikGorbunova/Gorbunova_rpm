# Copy to .env and replace both values. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg2://sirius:replace-with-random-database-password@127.0.0.1:15434/sirius
REDIS_URL=redis://127.0.0.1:16381/0
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]
CACHE_ENABLED=true
CACHE_WARMUP=true
MENU_TTL=300
CATEGORY_TTL=600
CACHE_LOCK_SECONDS=10
CACHE_WAIT_SECONDS=3
