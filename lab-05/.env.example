# Copy to .env and replace both values. Never commit .env.
POSTGRES_PASSWORD=replace-with-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg2://sirius:replace-with-random-database-password@127.0.0.1:15435/sirius
REDIS_URL=redis://127.0.0.1:16382/0
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000"]
CACHE_ENABLED=true
CACHE_WARMUP=true
MENU_TTL=300
CATEGORY_TTL=600
CACHE_LOCK_SECONDS=10
CACHE_WAIT_SECONDS=3
# Derived from REDIS_URL by default: broker DB 1, result backend DB 2.
# CELERY_BROKER_URL=redis://127.0.0.1:16382/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:16382/2
NOTIFICATION_MODE=celery
SIMULATED_PDF_SECONDS=2
SIMULATED_EMAIL_SECONDS=1
SIMULATED_SMS_SECONDS=1
DEMO_FAIL_EMAIL_MODULO=0
DEMO_TRANSIENT_EMAIL_FAILURES=0
RETRY_BASE_SECONDS=1
BEAT_CLEANUP_SECONDS=60
BEAT_OUTBOX_SECONDS=10
# Generate this secret using scripts/init_env.py; no default password.
FLOWER_BASIC_AUTH=monitor:replace-with-a-random-password
